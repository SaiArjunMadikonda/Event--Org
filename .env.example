# Copy this file to .env and fill in your Supabase project's values
# (Supabase dashboard → Connect → ORM → Prisma). Replace [YOUR-PASSWORD] in both lines.

# Transaction-mode pooler (port 6543), used by the app
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Session-mode pooler (port 5432), used by Prisma to create and change tables
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@[REGION].pooler.supabase.com:5432/postgres"
